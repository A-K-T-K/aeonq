# Evidence files are hashed byte-for-byte by archived trial records
# (requirements_lock_sha256) and by benchmarks/pipeline/audit_reproducibility.py.
# Store them exactly as written so every clone and tarball reproduces the hashes.
# Recognize CRLF when checking whitespace without normalizing hashed bytes.
requirements-lock.txt -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
benchmarks/experiment_manifest.yaml -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
benchmarks/results/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
